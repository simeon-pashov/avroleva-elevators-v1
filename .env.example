# Copy to .env (repo root). apps/api reads this file via dotenv (../../.env) — one .env for the monorepo.

# Postgres. Local dev reuses the shared dev Postgres container (see docker-compose.yml);
# the database `avroleva` (and `avroleva_test` for the integration tests) is created by `npm run db:migrate`.
DATABASE_URL="postgresql://unclecrm:unclecrm_dev_pw@localhost:5432/avroleva?schema=public"
TEST_DATABASE_URL="postgresql://unclecrm:unclecrm_dev_pw@localhost:5432/avroleva_test?schema=public"

# API
PORT=3005
NODE_ENV=development
LOG_LEVEL=info
# Path prefix when served behind nginx (e.g. /avroleva). Default "/". Must match VITE_BASE at build time.
BASE_PATH=/
PUBLIC_BASE_URL=http://localhost:3005
# Set "true" behind HTTPS (VPS). Cookies are then marked Secure and the proxy is trusted.
COOKIE_SECURE=false
# Long random string (openssl rand -hex 32). Used for signing / future file URLs.
SESSION_SECRET=dev-secret-change-me

# Platform admin — seeded (upserted) by `npm run db:seed`. Change in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# Demo tenant seed (idempotent). Set false in production.
SEED_DEMO=true

# Ports & adapters (ARCHITECTURE A1)
GEOCODER=nominatim         # nominatim | stub
NOMINATIM_URL=https://nominatim.openstreetmap.org
EMAIL_PROVIDER=console      # console | smtp
# SMTP_URL=smtp://user:pass@smtp.example.com:587   (EMAIL_PROVIDER=smtp)
EMAIL_FROM=noreply@avroleva.local
SMS_PROVIDER=console        # console | http (generic gateway: POST {to,text} JSON, Bearer token)
# SMS_HTTP_URL=https://sms-gateway.example.com/send
# SMS_HTTP_TOKEN=

# Scheduler / event delivery (pg-boss, schema "pgboss" in the same database - ARCHITECTURE D8/D9)
# ROLE=all runs API + worker in one process; ROLE=api only serves HTTP (still enqueues); ROLE=worker runs jobs only.
ROLE=all
WORKER_ENABLED=true         # false = no pg-boss: events delivered in-process, crons off (tests)
CRON_ENABLED=true           # false = queues only (no scheduled jobs)

# File storage (ARCHITECTURE section 6): local disk behind the FileStorage port. Relative to the API cwd.
DATA_DIR=./data
# Technician app: lowest accepted build (X-Min-Client-Version); the app asks to update below it.
MIN_CLIENT_VERSION=0.4.0
# Built technician app to serve at /tech/ (default: ../tech/dist next to apps/api)
# TECH_DIST=

# Office SPA (Vite). VITE_BASE must equal BASE_PATH (with trailing slash) when deployed under a prefix.
VITE_BASE=/
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Technician app (apps/tech, Vite). Served by the API at /tech/ in production; in dev it runs on :5176.
# VITE_TECH_BASE must be BASE_PATH + "/tech/". VITE_API_BASE = API origin (+ BASE_PATH), empty = same origin.
VITE_TECH_BASE=/tech/
VITE_API_BASE=
