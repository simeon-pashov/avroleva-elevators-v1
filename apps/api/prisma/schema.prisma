// Avroleva - Prisma schema (step 1: tenancy + registry + platform tables).
// Conventions (ARCHITECTURE section 3): UUIDv7 ids generated in code; every tenant-owned table has
// tenantId first in every index; money as integer cents; enums as Postgres enums; soft delete via deletedAt.
// Table ownership: apps/api/src/platform/db/ownership.ts

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- tenancy

enum TenantStatus {
  active
  read_only
  closed
  deletion_scheduled
}

enum UserRole {
  owner
  office
  technician
}

enum SessionKind {
  browser
  device
  admin
}

model Tenant {
  id                        String       @id @db.Uuid
  name                      String
  legalForm                 String?
  eik                       String
  vatNo                     String?
  vatRegistered             Boolean      @default(false)
  address                   String
  phone                     String
  emergencyPhone            String
  email                     String?
  locale                    String       @default("bg")
  timezone                  String       @default("Europe/Sofia")
  settings                  Json         @default("{}")
  features                  Json         @default("{}")
  status                    TenantStatus @default(active)
  /// Owner-requested deletion (30-day grace): the day the daily sweep purges everything.
  deletionAt                DateTime?    @db.Timestamptz
  deletionRequestedByUserId String?      @db.Uuid
  createdAt                 DateTime     @default(now()) @db.Timestamptz
  updatedAt                 DateTime     @updatedAt @db.Timestamptz
  deletedAt                 DateTime?    @db.Timestamptz

  users            User[]
  sessions         Session[]
  customers        Customer[]
  contacts         Contact[]
  buildings        Building[]
  elevators        Elevator[]
  contracts        Contract[]
  visits           Visit[]
  invoices         Invoice[]
  payments         Payment[]
  callbacks        Callback[]
  defects          Defect[]
  inspections      Inspection[]
  alarmTests       AlarmDeviceTest[]
  attachments      Attachment[]
  enrollmentTokens DeviceEnrollmentToken[]

  @@map("tenant")
}

model User {
  id           String    @id @db.Uuid
  tenantId     String    @db.Uuid
  role         UserRole
  name         String
  // Login is username + password (no tenant picker), so usernames are globally unique.
  username     String    @unique
  email        String?
  phone        String?
  passwordHash String
  locale       String?
  isActive     Boolean   @default(true)
  technician   Json?
  lastLoginAt  DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
  deletedAt    DateTime? @db.Timestamptz

  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  sessions         Session[]
  enrollmentTokens DeviceEnrollmentToken[]

  @@index([tenantId, role])
  @@map("user")
}

model PlatformAdmin {
  id           String   @id @db.Uuid
  username     String   @unique
  email        String?
  passwordHash String
  totpSecret   String?
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  sessions Session[]

  @@map("platform_admin")
}

// One session table for tenant users (tenantId + userId) and platform admins (adminId, kind=admin).
model Session {
  id            String      @id @db.Uuid
  tenantId      String?     @db.Uuid
  userId        String?     @db.Uuid
  adminId       String?     @db.Uuid
  tokenHash     String      @unique
  kind          SessionKind @default(browser)
  deviceName    String?
  clientVersion String?
  ip            String?
  createdAt     DateTime    @default(now()) @db.Timestamptz
  lastSeenAt    DateTime    @default(now()) @db.Timestamptz
  expiresAt     DateTime    @db.Timestamptz
  revokedAt     DateTime?   @db.Timestamptz

  tenant Tenant?        @relation(fields: [tenantId], references: [id])
  user   User?          @relation(fields: [userId], references: [id])
  admin  PlatformAdmin? @relation(fields: [adminId], references: [id])

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("session")
}

/// One-time code shown as a QR on the owner's screen; the phone exchanges it for a device session.
model DeviceEnrollmentToken {
  id              String    @id @db.Uuid
  tenantId        String    @db.Uuid
  userId          String    @db.Uuid
  codeHash        String    @unique
  expiresAt       DateTime  @db.Timestamptz
  usedAt          DateTime? @db.Timestamptz
  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
  @@map("device_enrollment_token")
}

// ---------------------------------------------------------------- registry

enum CustomerKind {
  etazhna_sobstvenost
  professional_manager
  company
  institution
}

enum ContactRole {
  house_manager
  cashier
  manager
  other
}

enum GeocodeStatus {
  pending
  ok
  failed
  manual
}

enum DriveType {
  electric
  hydraulic
  mrl
}

enum DoorType {
  manual
  semi_auto
  auto
}

enum ElevatorStatus {
  active
  stopped_by_firm
  stopped_by_authority
  out_of_contract
  scrapped
}

enum ContractStatus {
  draft
  active
  terminated
}

enum ImportStatus {
  preview
  committed
  rolled_back
}

model Customer {
  id             String       @id @db.Uuid
  tenantId       String       @db.Uuid
  kind           CustomerKind
  name           String
  eik            String?
  vatNo          String?
  billingAddress String?
  invoiceEmail   String?
  notes          String?
  createdBy      String?      @db.Uuid
  updatedBy      String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz
  deletedAt      DateTime?    @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  contacts  Contact[]
  buildings Building[]
  contracts Contract[]

  @@index([tenantId, name])
  @@map("customer")
}

model Contact {
  id         String      @id @db.Uuid
  tenantId   String      @db.Uuid
  customerId String?     @db.Uuid
  buildingId String?     @db.Uuid
  name       String
  role       ContactRole @default(house_manager)
  phone      String?
  hasViber   Boolean     @default(false)
  email      String?
  isPrimary  Boolean     @default(false)
  notes      String?
  createdAt  DateTime    @default(now()) @db.Timestamptz
  updatedAt  DateTime    @updatedAt @db.Timestamptz
  deletedAt  DateTime?   @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  building Building? @relation(fields: [buildingId], references: [id])

  @@index([tenantId, customerId])
  @@index([tenantId, buildingId])
  @@map("contact")
}

model Building {
  id                String        @id @db.Uuid
  tenantId          String        @db.Uuid
  customerId        String?       @db.Uuid
  address           Json
  addressText       String
  lat               Float?
  lng               Float?
  geocodeStatus     GeocodeStatus @default(pending)
  geocodeConfidence Float?
  geocodeProvider   String?
  accessNotes       String?
  keysLocation      String?
  notes             String?
  createdBy         String?       @db.Uuid
  updatedBy         String?       @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz
  updatedAt         DateTime      @updatedAt @db.Timestamptz
  deletedAt         DateTime?     @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  customer  Customer?  @relation(fields: [customerId], references: [id])
  elevators Elevator[]
  contacts  Contact[]
  contracts Contract[]
  visits    Visit[]
  invoices  Invoice[]
  payments  Payment[]
  callbacks Callback[]
  defects   Defect[]

  @@index([tenantId, customerId])
  @@index([tenantId, geocodeStatus])
  @@index([tenantId, addressText])
  @@map("building")
}

model Elevator {
  id                  String         @id @db.Uuid
  tenantId            String         @db.Uuid
  buildingId          String         @db.Uuid
  internalNo          String
  regNo               String?
  regNoNormalized     String?
  inspectionBody      String?
  manufacturer        String?
  year                Int?
  driveType           DriveType      @default(electric)
  doorType            DoorType       @default(manual)
  goodsOnly           Boolean        @default(false)
  stops               Int
  loadKg              Int?
  status              ElevatorStatus @default(active)
  checkIntervalDays   Int?
  lastCheckAt         DateTime?      @db.Date
  // Denormalised by the registry from lastCheckAt + interval (+ strategy, + override) so that the
  // map pins, the due board and the lists are one query. Recomputed on every change of its inputs.
  nextCheckDueAt      DateTime?      @db.Date
  // "Премести за утре": a one-off reschedule of the next check; cleared when a visit is recorded.
  nextCheckOverrideAt DateTime?      @db.Date
  nextInspectionAt    DateTime?      @db.Date
  alarmDevicePhone    String?
  alarmSimOperator    String?
  publicCode          String
  // Unguessable token of the public QR page (/p/:token); 128 bits hex, rotatable by the office.
  // Globally unique because the public facade resolves the tenant from it.
  publicToken         String         @unique
  stoppedAt           DateTime?      @db.Timestamptz
  stopReason          String?
  notes               String?
  createdBy           String?        @db.Uuid
  updatedBy           String?        @db.Uuid
  createdAt           DateTime       @default(now()) @db.Timestamptz
  updatedAt           DateTime       @updatedAt @db.Timestamptz
  deletedAt           DateTime?      @db.Timestamptz

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  building      Building           @relation(fields: [buildingId], references: [id])
  contractLines ContractElevator[]
  visits        Visit[]
  callbacks     Callback[]
  defects       Defect[]
  inspections   Inspection[]
  alarmTests    AlarmDeviceTest[]

  @@unique([tenantId, publicCode])
  @@index([tenantId, buildingId])
  @@index([tenantId, status])
  @@index([tenantId, regNoNormalized])
  @@index([tenantId, lastCheckAt])
  @@index([tenantId, nextCheckDueAt])
  @@map("elevator")
}

model Contract {
  id               String         @id @db.Uuid
  tenantId         String         @db.Uuid
  customerId       String         @db.Uuid
  buildingId       String         @db.Uuid
  startDate        DateTime       @db.Date
  endDate          DateTime?      @db.Date
  status           ContractStatus @default(active)
  paymentDay       Int?
  /// Billing override (ADR 0001): {cycle: monthly|quarterly|yearly, anchorDay?, exempt}; null = tenant default.
  billing          Json?
  notes            String?
  terminatedReason String?
  createdBy        String?        @db.Uuid
  updatedBy        String?        @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz
  updatedAt        DateTime       @updatedAt @db.Timestamptz
  deletedAt        DateTime?      @db.Timestamptz

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  customer Customer           @relation(fields: [customerId], references: [id])
  building Building           @relation(fields: [buildingId], references: [id])
  lines    ContractElevator[]

  @@index([tenantId, buildingId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("contract")
}

model ContractElevator {
  id                String    @id @db.Uuid
  tenantId          String    @db.Uuid
  contractId        String    @db.Uuid
  elevatorId        String    @db.Uuid
  monthlyPriceCents Int
  fromDate          DateTime? @db.Date
  toDate            DateTime? @db.Date

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  elevator Elevator @relation(fields: [elevatorId], references: [id])

  @@index([tenantId, contractId])
  @@index([tenantId, elevatorId])
  @@map("contract_elevator")
}

model ImportBatch {
  id          String       @id @db.Uuid
  tenantId    String       @db.Uuid
  filename    String
  status      ImportStatus @default(preview)
  rowCount    Int          @default(0)
  issues      Json         @default("[]")
  rows        Json         @default("[]")
  createdRows Json?
  createdBy   String?      @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz

  @@index([tenantId, createdAt])
  @@map("import_batch")
}

// ---------------------------------------------------------------- visits (L3)
// The visit record is evidence: append-only, corrections create a superseding row.
// Cross-module references (createdByUserId, supersedesVisitId) are plain ids; FKs only to identity
// tables (tenant, building, elevator) per ARCHITECTURE section 1.1 rule 4.

enum VisitKind {
  functional_check
  technical_maintenance
  repair
  callback
  other
}

enum VisitSource {
  office
  paper
  app
}

enum TimestampSource {
  device
  server
  manual
}

model Visit {
  id                String          @id @db.Uuid
  tenantId          String          @db.Uuid
  elevatorId        String          @db.Uuid
  buildingId        String          @db.Uuid
  kind              VisitKind
  startedAt         DateTime        @db.Timestamptz
  endedAt           DateTime?       @db.Timestamptz
  notes             String?
  source            VisitSource     @default(office)
  /// A13: which clock produced startedAt/endedAt and the phone's measured offset at the time.
  timestampSource   TimestampSource @default(server)
  clientOffsetMs    Int             @default(0)
  /// Checklist snapshot: template key/version + every answered item with its label (JSONB).
  templateKey       String?
  templateVersion   Int?
  checklist         Json?
  gps               Json?
  qualityFlags      Json            @default("[]")
  createdByUserId   String?         @db.Uuid
  supersedesVisitId String?         @db.Uuid
  supersededAt      DateTime?       @db.Timestamptz
  /// Set by the retention sweep when the visit's photos were purged (tenant.settings.retentionYears).
  photosPurgedAt    DateTime?       @db.Timestamptz
  createdAt         DateTime        @default(now()) @db.Timestamptz

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  elevator    Elevator          @relation(fields: [elevatorId], references: [id])
  building    Building          @relation(fields: [buildingId], references: [id])
  technicians VisitTechnician[]

  @@index([tenantId, elevatorId, startedAt(sort: Desc)])
  @@index([tenantId, startedAt(sort: Desc)])
  @@index([tenantId, buildingId])
  @@map("visit")
}

model VisitTechnician {
  id       String  @id @db.Uuid
  tenantId String  @db.Uuid
  visitId  String  @db.Uuid
  userId   String? @db.Uuid
  position Int     @default(1)
  /// Name as written on the paper page; kept even if the user is renamed or deleted.
  name     String

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([tenantId, visitId])
  @@index([tenantId, userId])
  @@map("visit_technician")
}

// ---------------------------------------------------------------- maintenance (L3)

/// Checklist templates: a system row (tenantId NULL) per key/version plus optional tenant clones
/// that shadow it. Items are JSONB [{code, group, bg, en, appliesTo, resultType}].
model ChecklistTemplate {
  id        String    @id @db.Uuid
  tenantId  String?   @db.Uuid
  key       String
  version   Int
  name      Json
  groups    Json      @default("[]")
  items     Json
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  @@unique([tenantId, key, version])
  @@index([tenantId, key, active])
  @@map("checklist_template")
}

// ---------------------------------------------------------------- documents (L2)

enum AttachmentKind {
  photo
  document
}

enum AttachmentRole {
  photo
  logbook_page
}

/// Uploaded file (photo re-encoded by sharp, EXIF stripped). id is client-generated (UUIDv7).
model Attachment {
  id              String         @id @db.Uuid
  tenantId        String         @db.Uuid
  kind            AttachmentKind @default(photo)
  /// sha256 of the bytes as uploaded (the client's hash), verified before re-encoding.
  sha256          String
  mime            String
  bytes           Int
  width           Int?
  height          Int?
  takenAt         DateTime?      @db.Timestamptz
  storageKey      String
  thumbKey        String?
  createdByUserId String?        @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, sha256])
  @@map("attachment")
}

/// Link visit -> attachment. Plain ids on both sides (rule 4): the visit arrives before its photos.
model VisitAttachment {
  id           String         @id @db.Uuid
  tenantId     String         @db.Uuid
  visitId      String         @db.Uuid
  attachmentId String         @db.Uuid
  role         AttachmentRole @default(photo)
  position     Int            @default(0)
  createdAt    DateTime       @default(now()) @db.Timestamptz

  @@unique([tenantId, visitId, attachmentId])
  @@index([tenantId, attachmentId])
  @@map("visit_attachment")
}

// ---------------------------------------------------------------- billing (L3, light)

enum InvoiceStatus {
  draft
  issued
  paid
  overdue
  void
  partially_paid
}

enum PaymentSource {
  manual
  bank_import
  provider
}

enum AdjustmentKind {
  late_fee
}

enum LateFeeKind {
  flat
  percent
}

enum BankImportStatus {
  preview
  committed
}

enum BankRowStatus {
  proposed
  matched
  unallocated
  ignored
  booked
}

enum BankMatchKind {
  reference
  amount_name
  manual
  none
}

enum PaymentLinkStatus {
  open
  paid
  expired
}

enum PaymentMethod {
  cash
  bank
  other
}

/// Gapless per-tenant numbering: the row is locked (SELECT ... FOR UPDATE) while a number is taken.
model InvoiceSequence {
  tenantId   String @id @db.Uuid
  nextNumber Int    @default(1)

  @@map("invoice_sequence")
}

model Invoice {
  id               String        @id @db.Uuid
  tenantId         String        @db.Uuid
  contractId       String        @db.Uuid
  buildingId       String        @db.Uuid
  customerId       String        @db.Uuid
  number           Int
  periodStart      DateTime      @db.Date
  periodEnd        DateTime      @db.Date
  issuedAt         DateTime      @db.Date
  dueAt            DateTime      @db.Date
  amountCents      Int
  vatCents         Int
  totalCents       Int
  paidCents        Int           @default(0)
  currency         String        @default("EUR")
  status           InvoiceStatus @default(issued)
  /// [{elevatorId, description, amountCents}]
  lines            Json          @default("[]")
  paidAt           DateTime?     @db.Date
  voidedAt         DateTime?     @db.Timestamptz
  voidReason       String?
  /// Immutable payer reference printed on every document: AE-<last 4 of EIK>-<6-digit number>.
  paymentReference String        @default("")
  /// 0 = no dunning yet, else the position of the last stage reached (ADR 0001).
  dunningStage     Int           @default(0)
  dunningStageKey  String?
  dunningAt        DateTime?     @db.Timestamptz
  /// Denormalised sums: late-fee adjustments and credit notes (open = total + lateFee - credited - paid).
  lateFeeCents     Int           @default(0)
  creditedCents    Int           @default(0)
  /// contract (billing run) today; job (repair jobs / quotes) from step 8.
  sourceType       String        @default("contract")
  sourceId         String?       @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz
  updatedAt        DateTime      @updatedAt @db.Timestamptz

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  building     Building            @relation(fields: [buildingId], references: [id])
  payments     Payment[]
  creditNotes  CreditNote[]
  adjustments  InvoiceAdjustment[]
  paymentLinks PaymentLink[]

  @@unique([tenantId, number])
  @@unique([tenantId, contractId, periodStart])
  @@unique([tenantId, paymentReference])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, buildingId, periodStart(sort: Desc)])
  @@index([tenantId, periodStart(sort: Desc)])
  @@map("invoice")
}

model Payment {
  id              String        @id @db.Uuid
  tenantId        String        @db.Uuid
  invoiceId       String?       @db.Uuid
  buildingId      String        @db.Uuid
  amountCents     Int
  paidAt          DateTime      @db.Date
  method          PaymentMethod @default(bank)
  note            String?
  /// What the payer wrote (the invoice's paymentReference when matched by it).
  reference       String?
  source          PaymentSource @default(manual)
  provider        String?
  providerRef     String?
  counterparty    String?
  bankImportRowId String?       @db.Uuid
  createdByUserId String?       @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  invoice  Invoice? @relation(fields: [invoiceId], references: [id])
  building Building @relation(fields: [buildingId], references: [id])

  @@index([tenantId, invoiceId])
  @@index([tenantId, buildingId, paidAt(sort: Desc)])
  @@index([tenantId, paidAt(sort: Desc)])
  @@index([tenantId, providerRef])
  @@map("payment")
}

/// Credit notes (ADR 0001): a numbered document that reduces an issued invoice's open balance.
model CreditNote {
  id              String   @id @db.Uuid
  tenantId        String   @db.Uuid
  invoiceId       String   @db.Uuid
  number          Int
  issuedAt        DateTime @db.Date
  amountCents     Int
  vatCents        Int
  totalCents      Int
  reason          String
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, invoiceId])
  @@index([tenantId, issuedAt(sort: Desc)])
  @@map("credit_note")
}

model CreditNoteSequence {
  tenantId   String @id @db.Uuid
  nextNumber Int    @default(1)

  @@map("credit_note_sequence")
}

/// Late fees and similar additions to an invoice's balance; the invoice row is never edited.
model InvoiceAdjustment {
  id          String         @id @db.Uuid
  tenantId    String         @db.Uuid
  invoiceId   String         @db.Uuid
  kind        AdjustmentKind @default(late_fee)
  amountCents Int
  reason      String?
  stageKey    String?
  createdAt   DateTime       @default(now()) @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId, invoiceId])
  @@map("invoice_adjustment")
}

/// Dunning as data: system rows (tenantId NULL) and tenant rows; a tenant with rows uses only its own.
model DunningStage {
  id             String              @id @db.Uuid
  tenantId       String?             @db.Uuid
  key            String
  position       Int
  offsetDays     Int
  channel        NotificationChannel
  templateKey    String
  lateFeeRuleKey String?
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now()) @db.Timestamptz
  updatedAt      DateTime            @updatedAt @db.Timestamptz

  @@unique([tenantId, key])
  @@index([tenantId, position])
  @@map("dunning_stage")
}

model LateFeeRule {
  id          String      @id @db.Uuid
  tenantId    String?     @db.Uuid
  key         String
  kind        LateFeeKind @default(flat)
  amountCents Int         @default(0)
  /// Basis points (100 = 1 %) of the invoice total, for kind = percent.
  percentBp   Int         @default(0)
  graceDays   Int         @default(0)
  capCents    Int?
  enabled     Boolean     @default(false)
  createdAt   DateTime    @default(now()) @db.Timestamptz
  updatedAt   DateTime    @updatedAt @db.Timestamptz

  @@unique([tenantId, key])
  @@map("late_fee_rule")
}

/// Bank-statement CSV import: preview -> match -> commit (ADR 0001 section 4).
model BankImport {
  id              String           @id @db.Uuid
  tenantId        String           @db.Uuid
  filename        String
  status          BankImportStatus @default(preview)
  mapping         Json
  rowCount        Int              @default(0)
  matchedCount    Int              @default(0)
  bookedCount     Int              @default(0)
  createdByUserId String?          @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz
  committedAt     DateTime?        @db.Timestamptz

  rows BankImportRow[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("bank_import")
}

model BankImportRow {
  id           String        @id @db.Uuid
  tenantId     String        @db.Uuid
  importId     String        @db.Uuid
  position     Int
  bookedAt     DateTime      @db.Date
  amountCents  Int
  counterparty String
  description  String
  reference    String?
  matchKind    BankMatchKind @default(none)
  invoiceId    String?       @db.Uuid
  buildingId   String?       @db.Uuid
  paymentId    String?       @db.Uuid
  status       BankRowStatus @default(unallocated)
  note         String?

  import BankImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([tenantId, importId, position])
  @@index([tenantId, status])
  @@map("bank_import_row")
}

/// Hosted-page payment links created through the PaymentProvider port (demo / iris / stripe).
model PaymentLink {
  id          String            @id @db.Uuid
  tenantId    String            @db.Uuid
  invoiceId   String            @db.Uuid
  provider    String
  token       String            @unique
  url         String
  amountCents Int
  status      PaymentLinkStatus @default(open)
  providerRef String?
  createdAt   DateTime          @default(now()) @db.Timestamptz
  expiresAt   DateTime          @db.Timestamptz
  paidAt      DateTime?         @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId, invoiceId])
  @@map("payment_link")
}

// ---------------------------------------------------------------- callbacks (L3)
// The callback row is a projection of its events; every transition appends a callback_event with
// timestamp provenance (at = when it happened per the source, receivedAt = server clock).

enum CallbackChannel {
  phone
  public_page
  office
}

enum CallbackClassification {
  trapped_persons
  breakdown
  complaint
  other
}

enum CallbackStatus {
  open
  dispatched
  on_site
  released
  restored
  closed
}

enum EventSource {
  office
  app
  public
}

enum ChargeReason {
  misuse
  vandalism
  water
  out_of_hours
  other
}

model Callback {
  id              String                 @id @db.Uuid
  tenantId        String                 @db.Uuid
  elevatorId      String                 @db.Uuid
  buildingId      String                 @db.Uuid
  channel         CallbackChannel        @default(phone)
  callerName      String?
  callerPhone     String?
  classification  CallbackClassification @default(breakdown)
  trappedCount    Int?
  description     String
  status          CallbackStatus         @default(open)
  receivedAt      DateTime               @db.Timestamptz
  dispatchedAt    DateTime?              @db.Timestamptz
  onSiteAt        DateTime?              @db.Timestamptz
  releasedAt      DateTime?              @db.Timestamptz
  restoredAt      DateTime?              @db.Timestamptz
  closedAt        DateTime?              @db.Timestamptz
  assignedUserId  String?                @db.Uuid
  cause           String?
  actionTaken     String?
  chargeable      Boolean                @default(false)
  chargeReason    ChargeReason?
  notes           String?
  /// Snapshot of tenant.settings.callbackSlaMinutes at intake.
  slaMinutes      Int
  closeoutVisitId String?                @db.Uuid
  source          EventSource            @default(office)
  createdByUserId String?                @db.Uuid
  createdAt       DateTime               @default(now()) @db.Timestamptz
  updatedAt       DateTime               @updatedAt @db.Timestamptz

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  elevator Elevator        @relation(fields: [elevatorId], references: [id])
  building Building        @relation(fields: [buildingId], references: [id])
  events   CallbackEvent[]

  @@index([tenantId, status, receivedAt(sort: Desc)])
  @@index([tenantId, elevatorId, receivedAt(sort: Desc)])
  @@index([tenantId, receivedAt(sort: Desc)])
  @@index([tenantId, assignedUserId, status])
  @@map("callback")
}

model CallbackEvent {
  id         String      @id @db.Uuid
  tenantId   String      @db.Uuid
  callbackId String      @db.Uuid
  type       String
  at         DateTime    @db.Timestamptz
  receivedAt DateTime    @default(now()) @db.Timestamptz
  source     EventSource @default(office)
  byUserId   String?     @db.Uuid
  data       Json        @default("{}")

  callback Callback @relation(fields: [callbackId], references: [id], onDelete: Cascade)

  @@index([tenantId, callbackId, at])
  @@map("callback_event")
}

// ---------------------------------------------------------------- defects (L3)

enum DefectStatus {
  open
  notified
  awaiting_approval
  scheduled
  resolved
}

enum DefectSource {
  visit
  callback
  office
}

enum DefectSeverity {
  low
  medium
  high
}

model Defect {
  id                  String         @id @db.Uuid
  tenantId            String         @db.Uuid
  elevatorId          String         @db.Uuid
  buildingId          String         @db.Uuid
  /// "1".."17" from packages/domain-data/defects/art10.v1.json, "other" or null (free text).
  catalogCode         String?
  description         String
  severity            DefectSeverity @default(medium)
  stopLift            Boolean        @default(false)
  status              DefectStatus   @default(open)
  recordedAt          DateTime       @db.Timestamptz
  sourceType          DefectSource   @default(office)
  sourceId            String?        @db.Uuid
  noticeSentAt        DateTime?      @db.Timestamptz
  customerRequestedAt DateTime?      @db.Timestamptz
  followUpDueAt       DateTime       @db.Date
  resolvedAt          DateTime?      @db.Timestamptz
  resolvedVisitId     String?        @db.Uuid
  notes               String?
  createdByUserId     String?        @db.Uuid
  createdAt           DateTime       @default(now()) @db.Timestamptz
  updatedAt           DateTime       @updatedAt @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  elevator Elevator @relation(fields: [elevatorId], references: [id])
  building Building @relation(fields: [buildingId], references: [id])

  @@index([tenantId, status, followUpDueAt])
  @@index([tenantId, elevatorId, recordedAt(sort: Desc)])
  @@index([tenantId, recordedAt(sort: Desc)])
  @@map("defect")
}

// ---------------------------------------------------------------- calendar (L3)

enum InspectionKind {
  periodic
  after_repair
  after_stop
  other
}

enum InspectionResult {
  passed
  passed_with_defects
  failed
  pending
}

model Inspection {
  id              String           @id @db.Uuid
  tenantId        String           @db.Uuid
  elevatorId      String           @db.Uuid
  kind            InspectionKind   @default(periodic)
  requestedAt     DateTime?        @db.Date
  scheduledAt     DateTime?        @db.Date
  performedAt     DateTime?        @db.Date
  result          InspectionResult @default(pending)
  inspectionBody  String?
  nextDueAt       DateTime?        @db.Date
  notes           String?
  /// [{text, deadline, closed}]
  defects         Json             @default("[]")
  createdByUserId String?          @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  elevator Elevator @relation(fields: [elevatorId], references: [id])

  @@index([tenantId, elevatorId, performedAt(sort: Desc)])
  @@index([tenantId, nextDueAt])
  @@index([tenantId, scheduledAt])
  @@map("inspection")
}

model AlarmDeviceTest {
  id         String   @id @db.Uuid
  tenantId   String   @db.Uuid
  elevatorId String   @db.Uuid
  testedAt   DateTime @db.Timestamptz
  ok         Boolean  @default(true)
  notes      String?
  byUserId   String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  elevator Elevator @relation(fields: [elevatorId], references: [id])

  @@index([tenantId, elevatorId, testedAt(sort: Desc)])
  @@map("alarm_device_test")
}

// ---------------------------------------------------------------- platform

model DomainEvent {
  id            String   @id @db.Uuid
  tenantId      String?  @db.Uuid
  type          String
  version       Int      @default(1)
  aggregateType String
  aggregateId   String   @db.Uuid
  payload       Json
  occurredAt    DateTime @default(now()) @db.Timestamptz
  causationId   String?  @db.Uuid
  correlationId String?  @db.Uuid

  @@index([tenantId, occurredAt])
  @@index([aggregateType, aggregateId])
  @@map("domain_event")
}

/// Stored response of a mutating request under an Idempotency-Key (7-day TTL, ARCHITECTURE section 5).
model IdempotencyKey {
  tenantId       String   @db.Uuid
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@id([tenantId, key])
  @@index([createdAt])
  @@map("idempotency_key")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  tenantId   String?  @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz
  actorType  String
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  requestId  String?
  ip         String?

  @@index([tenantId, at])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// ---------------------------------------------------------------- notifications (L4)

enum NotificationChannel {
  email
  sms
  viber_link
  in_app
}

enum NotificationStatus {
  queued
  sent
  failed
  skipped
}

enum RecipientKind {
  building_contact
  owner
  office
  assigned_technician
}

/// Handlebars templates: system rows (tenantId NULL) per key/channel/locale, tenant rows shadow them.
model NotificationTemplate {
  id        String              @id @db.Uuid
  tenantId  String?             @db.Uuid
  key       String
  channel   NotificationChannel
  locale    String
  subject   String?
  body      String
  active    Boolean             @default(true)
  createdAt DateTime            @default(now()) @db.Timestamptz
  updatedAt DateTime            @updatedAt @db.Timestamptz
  deletedAt DateTime?           @db.Timestamptz

  @@unique([tenantId, key, channel, locale])
  @@index([key, channel, locale])
  @@map("notification_template")
}

/// Which event goes out on which channel to whom (ARCHITECTURE A8: the rule table decides).
model NotificationRule {
  id            String              @id @db.Uuid
  tenantId      String              @db.Uuid
  eventType     String
  channel       NotificationChannel
  recipientKind RecipientKind
  enabled       Boolean             @default(true)
  config        Json                @default("{}")
  createdAt     DateTime            @default(now()) @db.Timestamptz
  updatedAt     DateTime            @updatedAt @db.Timestamptz

  @@unique([tenantId, eventType, channel, recipientKind])
  @@map("notification_rule")
}

/// Delivery log (append-only): one row per recipient per channel. In-app rows are addressed to a user.
model Notification {
  id          String              @id @db.Uuid
  tenantId    String              @db.Uuid
  ruleId      String?             @db.Uuid
  eventId     String?             @db.Uuid
  eventType   String?
  channel     NotificationChannel
  to          String
  userId      String?             @db.Uuid
  subject     String?
  body        String
  status      NotificationStatus  @default(queued)
  providerId  String?
  error       String?
  relatedType String?
  relatedId   String?             @db.Uuid
  link        String?
  /// viber_link rows: {number, chatUrl, forwardUrl, webUrl, text}; e-mail rows: {html?, attachments?}.
  meta        Json?
  attempts    Int                 @default(0)
  readAt      DateTime?           @db.Timestamptz
  createdAt   DateTime            @default(now()) @db.Timestamptz
  sentAt      DateTime?           @db.Timestamptz

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, userId, readAt])
  @@index([tenantId, status])
  @@index([tenantId, relatedType, relatedId])
  @@map("notification")
}

// ---------------------------------------------------------------- reporting (L4)

enum ExportJobStatus {
  queued
  running
  done
  failed
}

model ExportJob {
  id                String          @id @db.Uuid
  tenantId          String          @db.Uuid
  kind              String          @default("full")
  status            ExportJobStatus @default(queued)
  requestedByUserId String?         @db.Uuid
  storageKey        String?
  bytes             Int?
  summary           Json?
  error             String?
  createdAt         DateTime        @default(now()) @db.Timestamptz
  startedAt         DateTime?       @db.Timestamptz
  finishedAt        DateTime?       @db.Timestamptz
  expiresAt         DateTime?       @db.Timestamptz

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("export_job")
}

enum ReportRunStatus {
  generated
  sent
  failed
  skipped
}

model ReportRun {
  id             String          @id @db.Uuid
  tenantId       String          @db.Uuid
  kind           String          @default("building_month")
  buildingId     String?         @db.Uuid
  period         String
  status         ReportRunStatus @default(generated)
  sentTo         String?
  notificationId String?         @db.Uuid
  error          String?
  byUserId       String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, buildingId, period])
  @@map("report_run")
}

// ---------------------------------------------------------------- platform: event delivery + jobs

enum DeliveryStatus {
  pending
  done
  failed
}

/// Per-(event, handler) delivery record: idempotency for the pg-boss dispatcher (ARCHITECTURE A8).
model EventDelivery {
  eventId     String         @db.Uuid
  handler     String
  status      DeliveryStatus @default(pending)
  attempts    Int            @default(0)
  lastError   String?
  createdAt   DateTime       @default(now()) @db.Timestamptz
  processedAt DateTime?      @db.Timestamptz

  @@id([eventId, handler])
  @@index([status, createdAt])
  @@map("event_delivery")
}

/// Last run per scheduled job, shown on /health and /admin.
model JobRun {
  name           String    @id
  cron           String?
  lastStartedAt  DateTime? @db.Timestamptz
  lastFinishedAt DateTime? @db.Timestamptz
  lastStatus     String?
  lastError      String?
  lastDurationMs Int?
  lastResult     Json?

  @@map("job_run")
}
