# Copy to android/keystore.properties (git-ignored) to sign release builds locally.
# See docs/ANDROID-RELEASE.md. The same four keys also work as Gradle properties
# (~/.gradle/gradle.properties or -PAVROLEVA_STORE_FILE=... on the command line).
AVROLEVA_STORE_FILE=C:\\Users\\<you>\\.avroleva\\android-release.jks
AVROLEVA_STORE_PASSWORD=<store password from %USERPROFILE%\\.avroleva\\android-keystore.txt>
AVROLEVA_KEY_ALIAS=avroleva
AVROLEVA_KEY_PASSWORD=<same as the store password unless set differently>
