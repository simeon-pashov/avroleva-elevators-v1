# Avroleva Elevators - production environment for docker-compose.prod.yml.
# Copy to `.env` next to the compose file ON THE VPS (never commit it; `git pull` never touches it).
#   cp .env.production.example .env && nano .env
# Secrets: generate each one with `openssl rand -hex 32` and paste the value.

# ---------------------------------------------------------------- Postgres (own container, no host port)
# Letters/digits only (the values are interpolated into DATABASE_URL without URL-encoding).
POSTGRES_USER=avroleva
POSTGRES_PASSWORD=<openssl rand -hex 32>
POSTGRES_DB=avroleva

# ---------------------------------------------------------------- app secrets
# Session token signing + signed file URLs (HMAC). Rotating it logs everyone out.
SESSION_SECRET=<openssl rand -hex 32>
# Platform admin (the /admin login). Upserted at EVERY container start: changing this value and
# restarting the app resets the password. Minimum 8 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<openssl rand -hex 32>

# ---------------------------------------------------------------- where the app lives
# Host port that nginx proxies to (container port is always 3005). Bound to 127.0.0.1 only.
APP_HOST_PORT=3005
# Path prefix stripped by nginx (VPS-GUIDE). BASE_PATH has no trailing slash, VITE_BASE has one.
# With a custom domain later: BASE_PATH=/  VITE_BASE=/  PUBLIC_BASE_URL=https://app.example.bg (origin)
BASE_PATH=/avroleva
# Baked into both SPAs at image build time (compose passes it as a build arg) - rebuild after changing it.
VITE_BASE=/avroleva/
# Public ORIGIN (scheme + host only - no path, no trailing slash). The app appends BASE_PATH itself
# (apps/api/src/platform/urls.ts) when it builds QR labels, phone-enrollment links, e-mail and export
# links; "https://srv1662742.hstgr.cloud/avroleva" here would yield /avroleva/avroleva/... links.
PUBLIC_BASE_URL=https://srv1662742.hstgr.cloud
# true behind HTTPS (cookies get the Secure flag and X-Forwarded-Proto is trusted). Production: true.
COOKIE_SECURE=true

# ---------------------------------------------------------------- seeding
# Demo tenant (demo/demo1234 etc.). Production: false. The system templates and the platform
# admin are seeded regardless.
SEED_DEMO=false

# ---------------------------------------------------------------- scheduler (pg-boss, schema "pgboss")
# all = API + worker in one process (default). api / worker = split into two services later.
ROLE=all
WORKER_ENABLED=true
CRON_ENABLED=true

# ---------------------------------------------------------------- e-mail (ports & adapters)
# console = log only (no e-mail leaves the server). smtp = real delivery via SMTP_URL.
EMAIL_PROVIDER=console
# smtp://user:pass@smtp.example.com:587  or  smtps://user:pass@smtp.example.com:465
SMTP_URL=
# From address of outgoing e-mail (the tenant's name is prepended as display name).
EMAIL_FROM=noreply@avroleva.local

# ---------------------------------------------------------------- SMS (ports & adapters)
# console = log only. http = generic gateway: POST {to,text} as JSON with a Bearer token.
SMS_PROVIDER=console
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# ---------------------------------------------------------------- geocoding
# nominatim (public OSM service, 1 req/s etiquette) | stub (no network; addresses are not geocoded)
GEOCODER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org

# ---------------------------------------------------------------- technician app
# Lowest accepted build of the PWA (X-Min-Client-Version); older phones are asked to update.
MIN_CLIENT_VERSION=0.4.0

# ---------------------------------------------------------------- logging
LOG_LEVEL=info
